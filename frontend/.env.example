# Build-time settings for the web page. Copy to ".env.local" (ignored by git) only if you need to change something.
# Nothing here is secret: values prefixed with VITE_ are written into the public web page.

# Path the site is served from. The GitHub Actions workflow sets this for you.
#   Project site  https://<name>.github.io/<repository>/   ->  VITE_BASE=/<repository>/
#   User site / custom domain (served from the root)        ->  VITE_BASE=/
# For local development leave it unset.
VITE_BASE=/
