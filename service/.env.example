# Copy this file to ".env" (same folder) and change what you need. Every setting is optional.
# Lines starting with # are comments. ".env" is ignored by git, so it never gets published.

# --- Where the service listens -------------------------------------------------------------------
# The service only ever listens on this computer (127.0.0.1). It refuses any other address.
PORT=4577

# --- Which websites may control the service ------------------------------------------------------
# The address of YOUR copy of the web page, exactly as it appears in the browser, without a path.
# Example for GitHub Pages:   https://your-name.github.io
# Several addresses can be separated by commas or spaces.
ALLOWED_ORIGINS=

# Also accept pages served from this computer (http://localhost:5173, http://127.0.0.1:4173 ...).
# Needed when you run the web page yourself with "npm run dev" or "npm run preview".
ALLOW_LOCALHOST_ORIGINS=true

# Optional: your web page address. When set, the start-up message prints a one-click pairing link.
# Example: https://your-name.github.io/screenshot-gallery/
FRONTEND_URL=

# --- Pairing token --------------------------------------------------------------------------------
# Leave empty: a random token is created on first start and saved in data/pairing-token.txt.
# Only set this if you want to choose the token yourself (24 or more letters, digits, - _ . ~ + / =).
# Never commit a real token.
PAIRING_TOKEN=

# --- Files ----------------------------------------------------------------------------------------
# Folders are relative to the "service" folder unless you give a full path such as D:\Screenshots.
SCREENSHOTS_DIR=screenshots
DATA_DIR=data

# --- Browser --------------------------------------------------------------------------------------
# Full path to msedge.exe. Only needed if Edge is installed in an unusual place.
# Example: EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
EDGE_PATH=

# Full-page screenshots taller than this many pixels are cut off at this height (1000 - 100000).
MAX_FULLPAGE_HEIGHT=30000

# --- Safety: which addresses may be captured ------------------------------------------------------
# By default the service refuses addresses on this computer or your private network (localhost,
# 192.168.x.x, 10.x.x.x, 169.254.x.x ...), so a web page cannot use it to reach internal services.
# Set to true only if you want to capture such pages (for example an intranet or a local dev site).
ALLOW_PRIVATE_TARGETS=false

# Alternatively allow just specific host names while keeping the protection on. Comma separated.
# Example: ALLOWED_TARGET_HOSTS=intranet.example.com,localhost
ALLOWED_TARGET_HOSTS=

# --- Logging --------------------------------------------------------------------------------------
# debug, info, warn, error or silent
LOG_LEVEL=info
