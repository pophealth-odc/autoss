{
  "name": "screenshot-gallery-service",
  "version": "1.0.0",
  "private": true,
  "description": "Local automation service for Browser Screenshot Automation & Gallery. Drives Microsoft Edge with Playwright and serves screenshots to the web UI on 127.0.0.1.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "express": "^5.3.0",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
