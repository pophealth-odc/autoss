# Normalise line endings in the repository; check out Windows scripts with CRLF, which cmd.exe requires to parse reliably.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Lock files are generated; keep them out of diffs and never rewrite their line endings.
package-lock.json -diff linguist-generated=true

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.zip binary
